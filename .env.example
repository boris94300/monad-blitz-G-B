# Facultatif : sans clé, la reconnaissance COCO-SSD tourne dans le navigateur.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Adresse après déploiement du contrat sur Monad Testnet uniquement.
CONTRACT_ADDRESS=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PORT=3000
# URL HTTPS publique à afficher dans les QR codes (sinon origine du navigateur).
PUBLIC_URL=
# Facultatif : relais TURN pour les réseaux qui bloquent WebRTC.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Facultatif : mesure d'audience (Plausible ou compatible), chargée seulement après acceptation du bandeau cookies.
ANALYTICS_DOMAIN=
ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# Adresse de contact affichée dans les pages légales (CGU, confidentialité).
CONTACT_EMAIL=
